# Copy this file to client/.env
# NOTE: anything starting with VITE_ is bundled into the browser code, so it is PUBLIC.
#       Never put real secrets (database, JWT, OpenAI key...) here - those belong in server/.env.

# --- How the frontend reaches the backend ---------------------------------
# Development: leave VITE_API_URL empty. The browser calls /api/... on the Vite
# dev server, and Vite forwards it to API_PROXY_TARGET (your Express server).
API_PROXY_TARGET=http://localhost:5000
CLIENT_PORT=5173

# Production only: full URL of the API when it lives on another domain,
# e.g. https://api.example.com/api   (leave empty when served from the same origin)
VITE_API_URL=

# --- Demo account button on the login page (optional, public) -----------
# Must match DEMO_USER_EMAIL / DEMO_USER_PASSWORD in server/.env. Leave empty to hide the button.
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=

# --- Maps (optional) -------------------------------------------------------
# Walking-route service (OSRM compatible). Empty = public OpenStreetMap foot router.
VITE_ROUTING_URL=
# Google Maps instead of OpenStreetMap. Empty = OpenStreetMap (free).
# Restrict this key to your domain in Google Cloud, because it is visible in the browser.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAP_ID=
