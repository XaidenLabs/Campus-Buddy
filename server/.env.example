# Copy this file to .env and fill in your values

PORT=5000

# REQUIRED. Local MongoDB, or a MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/campusbuddy

# REQUIRED. Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Frontend origin(s) allowed to call the API (comma separated)
CLIENT_ORIGIN=http://localhost:5173

# OpenAI - leave OPENAI_API_KEY empty to use the built-in offline answers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Fill the database with sample NSUK data on first start when it is empty
AUTO_SEED=true

# First admin account (created only if the database has no admin yet)
# Both must be set, otherwise no admin is created
ADMIN_EMAIL=admin@nsuk.edu.ng
ADMIN_PASSWORD=

# Demo student created with the sample data (leave empty to skip it).
# Put the same values in client/.env as VITE_DEMO_EMAIL / VITE_DEMO_PASSWORD to show the "demo account" button.
DEMO_USER_EMAIL=johnson@nsuk.edu.ng
DEMO_USER_PASSWORD=

# Public DNS servers, fixes "querySrv ECONNREFUSED" with MongoDB Atlas. Empty = off
DNS_SERVERS=8.8.8.8,1.1.1.1

# Website address (used inside password-reset emails)
CLIENT_URL=http://localhost:5173

# Email for password resets (optional). Leave empty and reset links are printed in the server terminal.
# Gmail example: SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=you@gmail.com  SMTP_PASS=<16-letter app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CampusBuddy <you@gmail.com>
